# MinIO S3-compatible storage
MINIO_ROOT_USER=lakehouse_admin
MINIO_ROOT_PASSWORD=change_me_minio_password
AWS_REGION=us-east-1

# PostgreSQL
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=change_me_postgres_password

# Lakekeeper (Iceberg REST Catalog)
LAKEKEEPER_DB_NAME=lakekeeper
LAKEKEEPER_PORT=8181

# Apache Airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Ingestion and Bronze runtime settings
TLCN_DATA_ROOT=data
TLCN_BRONZE_ROOT=data/bronze
TLCN_BRONZE_S3_URI=s3://lakehouse/bronze
TLCN_HISTORICAL_ROOT=data/historical
TLCN_REFERENCE_ROOT=data/reference

# External data sources
OVERPASS_URL=https://overpass-api.de/api/interpreter
PROVINCES_SOURCE_URL=https://api.github.com/repos/thanglequoc/vietnamese-provinces-database/contents/json/geojson
PROVINCES_RAW_BASE_URL=https://raw.githubusercontent.com/thanglequoc/vietnamese-provinces-database/master/json/geojson
TLCN_USER_AGENT=TLCN-Tourism-Research/1.0
REQUEST_TIMEOUT_SECONDS=180
OVERPASS_TIMEOUT_SECONDS=120
PROVINCE_REQUEST_TIMEOUT_SECONDS=30

# Crawl behavior
CRAWL_MAX_WORKERS=1
CRAWL_MAX_RETRIES=2
CRAWL_RETRY_BACKOFF_SECONDS=2.0
REQUEST_JITTER_MIN_SECONDS=0.3
REQUEST_JITTER_MAX_SECONDS=1.2
TLCN_TEST_MODE=true
TEST_PROVINCE=
BOUNDARY_REVIEW_DISTANCE_M=1000.0
HEADLESS=true

# Google Maps and YouTube limits
# 0 means no limit for the corresponding job.
GOOGLE_MAPS_RATINGS_LIMIT=1
GOOGLE_MAPS_REVIEWS_LIMIT=1
YOUTUBE_MAX_PLACES=1
YOUTUBE_MAX_VIDEOS=1
YOUTUBE_MAX_COMMENTS=1
GOOGLE_MAPS_DELAY_SECONDS=1.0
GOOGLE_MAPS_REVIEWS_DELAY_SECONDS=1.0
YOUTUBE_DELAY_SECONDS=1
TLCN_REFRESH_SUCCESS=false
TLCN_CRAWL_TIERS=tier_1,tier_2,tier_3

# Browser/crawler settings
MAX_REVIEWS_PER_PLACE=100
MAX_SCROLL_ATTEMPTS=25
SCROLL_PAUSE_SECONDS=1.5
PAGE_TIMEOUT_MS=45000
LOAD_RETRIES=2
TEST_LIMIT=0
PLACE_IDS=

# Secrets: set locally and never commit them.
YOUTUBE_API_KEY=
DISCORD_INGESTION_WEBHOOK_URL=
