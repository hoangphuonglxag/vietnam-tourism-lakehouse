TLCN_CRAWL_TIERS=tier_1,tier_2,tier_3
# MinIO S3-Compatible Storage
MINIO_ROOT_USER=lakehouse_admin
MINIO_ROOT_PASSWORD=SuperSecretMinioPassword123
AWS_REGION=us-east-1

# PostgreSQL
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=SuperSecretPgPassword123

# Lakekeeper (Iceberg REST Catalog)
LAKEKEEPER_DB_NAME=lakekeeper
LAKEKEEPER_PORT=8181

# Apache Airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Paths are relative to the project root unless absolute.
TLCN_DATA_ROOT=data
TLCN_BRONZE_ROOT=data/bronze
TLCN_HISTORICAL_ROOT=data/historical
TLCN_REFERENCE_ROOT=data/reference

# Browser/crawler settings
HEADLESS=false
MAX_REVIEWS_PER_PLACE=100
MAX_SCROLL_ATTEMPTS=25
SCROLL_PAUSE_SECONDS=1.5
PAGE_TIMEOUT_MS=45000
LOAD_RETRIES=2

# Optional local test scope
TEST_LIMIT=0
TEST_PROVINCE=
PLACE_IDS=

# Secret: set locally, never commit it.
YOUTUBE_API_KEY=

GOOGLE_MAPS_RATINGS_LIMIT=1
GOOGLE_MAPS_REVIEWS_LIMIT=1
YOUTUBE_MAX_PLACES=1
YOUTUBE_MAX_VIDEOS=1
YOUTUBE_MAX_COMMENTS=1
GOOGLE_MAPS_DELAY_SECONDS=1.0
GOOGLE_MAPS_REVIEWS_DELAY_SECONDS=1.0