table gold_obt_place_360_profile
	lineageTag: 3eb5179c-545c-4c86-9a52-3d93ed960159

	measure 'Total Places' = COUNTROWS('gold_obt_place_360_profile')
		formatString: #,0
		lineageTag: f4aa7965-94d3-4a57-85db-2e416846267b

	measure 'Total Google Reviews' = SUM('gold_obt_place_360_profile'[latest_google_review_count])
		formatString: #,0
		lineageTag: 9d85d077-9fa9-468a-a1ea-0ae590c5ad34

	measure 'Total YouTube Views' = SUM('gold_obt_place_360_profile'[total_youtube_views])
		formatString: #,0
		lineageTag: 4eeca770-5efd-4cb2-95eb-a787898333d2

	measure 'Weighted Rating' = DIVIDE(SUMX('gold_obt_place_360_profile', 'gold_obt_place_360_profile'[latest_google_rating] * 'gold_obt_place_360_profile'[latest_google_review_count]), SUMX(FILTER('gold_obt_place_360_profile', NOT ISBLANK('gold_obt_place_360_profile'[latest_google_rating])), 'gold_obt_place_360_profile'[latest_google_review_count]))
		formatString: 0.00
		lineageTag: 528f6755-490f-456e-b75a-a5d6d7b41fef

	measure 'Avg Rating' = AVERAGE('gold_obt_place_360_profile'[latest_google_rating])
		formatString: 0.00
		lineageTag: d0b8509a-aae3-4bd3-9c68-716a5f2130e6

	measure 'Media Score' = LOG10(1 + SUM('gold_obt_place_360_profile'[total_youtube_views]))
		formatString: 0.00
		lineageTag: a5c8fd6f-b475-49a9-8d62-c1a30babeaa7

	measure 'Leading Hotspots' = COUNTROWS(FILTER('gold_obt_place_360_profile', NOT ISBLANK('gold_obt_place_360_profile'[latest_google_rating]) && 'gold_obt_place_360_profile'[latest_google_rating] >= 4.35 && 'gold_obt_place_360_profile'[total_youtube_views] >= 50000)) + 0
		formatString: #,0
		lineageTag: 416cf61e-a68f-4db8-99fd-d27adff9daf5

	measure 'Hidden Gems' = COUNTROWS(FILTER('gold_obt_place_360_profile', NOT ISBLANK('gold_obt_place_360_profile'[latest_google_rating]) && 'gold_obt_place_360_profile'[latest_google_rating] >= 4.35 && 'gold_obt_place_360_profile'[total_youtube_views] < 50000)) + 0
		formatString: #,0
		lineageTag: 7d88a802-0d94-4883-959a-ec8db81a14f4

	measure 'Tourist Traps' = COUNTROWS(FILTER('gold_obt_place_360_profile', NOT ISBLANK('gold_obt_place_360_profile'[latest_google_rating]) && 'gold_obt_place_360_profile'[latest_google_rating] < 4.35 && 'gold_obt_place_360_profile'[total_youtube_views] >= 50000)) + 0
		formatString: #,0
		lineageTag: f0144371-d67d-4a6a-9068-d724c1b8d656

